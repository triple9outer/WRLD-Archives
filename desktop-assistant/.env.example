DISCORD_BOT_TOKEN=put-your-bot-token-here
DISCORD_APPLICATION_ID=put-your-application-id-here
DISCORD_GUILD_ID=put-your-server-id-here
WRLD_AI_MODEL=qwen3:1.7b

# Optional Discord Rich Presence: use a Discord Application ID, not the bot token.
WRLD_DISCORD_APPLICATION_ID=
# If this app is hosted elsewhere, set the exact website origin, with no path.
# Example: https://username.github.io
WRLD_ARCHIVES_ORIGIN=
# Optional image key uploaded to the Discord application's Rich Presence assets.
WRLD_DISCORD_ASSET_KEY=
